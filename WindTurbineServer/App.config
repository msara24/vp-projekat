<?xml version="1.0" encoding="utf-8" ?>

<configuration>

  <system.serviceModel>

    <services>

      <service
        name="WindTurbineServer.WindTurbineService">

        <endpoint
          address=""
          binding="netTcpBinding"
          contract="WindTurbineContracts.IWindTurbineService" />

        <host>
          <baseAddresses>

            <add
              baseAddress="net.tcp://localhost:9000/WindService"/>

          </baseAddresses>
        </host>

      </service>

    </services>

    <bindings>

      <netTcpBinding>

        <binding
          transferMode="Streamed"
          maxReceivedMessageSize="10485760"/>

      </netTcpBinding>

    </bindings>

  </system.serviceModel>

</configuration>