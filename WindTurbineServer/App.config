<?xml version="1.0" encoding="utf-8"?>

<configuration>

	<!-- KT2 SETTINGS -->
	<appSettings>
		<add key="WindSpikeThreshold" value="5.0"/>
		<add key="CutInWindSpeed" value="3.0"/>
		<add key="NacelleThreshold" value="20"/>
		<add key="PowerDropThreshold" value="30"/>
	</appSettings>

	<system.serviceModel>

		<services>

			<service name="WindTurbineServer.WindTurbineService">

				<endpoint
				  address=""
				  binding="netTcpBinding"
				  bindingConfiguration="TcpConfig"
				  contract="WindTurbineContracts.IWindTurbineService" />

				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:9000/WindService"/>
					</baseAddresses>
				</host>

			</service>

		</services>

		<bindings>

			<netTcpBinding>

				<binding
				  name="TcpConfig"
				  transferMode="Streamed"
				  maxReceivedMessageSize="10485760"
				  maxBufferSize="10485760"
				  maxBufferPoolSize="524288"
				  receiveTimeout="00:10:00"
				  sendTimeout="00:10:00">

					<security mode="None"/>

				</binding>

			</netTcpBinding>

		</bindings>

	</system.serviceModel>

</configuration>